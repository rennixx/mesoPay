{
  "name": "mesopotamia-sdk",
  "version": "0.1.0",
  "description": "Unified Iraqi payment gateway SDK for Node.js - supporting ZainCash, FastPay, and FIB",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "example:basic": "ts-node examples/basic-usage.ts",
    "example:mock": "ts-node examples/mock-gateway-test.ts",
    "mock-gateway": "ts-node mock-gateway/server.ts"
  },
  "keywords": [
    "payment",
    "iraq",
    "zaincash",
    "fastpay",
    "fib",
    "gateway",
    "mesopotamia"
  ],
  "author": "Mesopotamia SDK Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesopotamia-sdk/mesopotamia-sdk.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jsonwebtoken": "^9.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
